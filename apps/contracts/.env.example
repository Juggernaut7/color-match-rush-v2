# Copy this file to .env. Never commit .env or share your private key.
# Use a dedicated deployer wallet funded only with the gas token needed.
PRIVATE_KEY=

# Arc RPC endpoints
ARC_RPC_URL=https://rpc.mainnet.arc.io
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io

# Native USDC entry fee per player. Arc uses native USDC (18 decimals) for gas and transfers.
ARC_ENTRY_FEE=0.5

# Required for round management after deployment.
TREASURY_ADDRESS=
ROUND_ID=
ROUND_ACTION=
ROUND_DURATION_SECONDS=86400
FIRST_PLACE=
SECOND_PLACE=
THIRD_PLACE=

# Optional: set to true to enable the gas reporter
REPORT_GAS=false
